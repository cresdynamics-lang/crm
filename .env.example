NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER@localhost:5432/cres_crm
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# Outbound (Resend)
MAIL_MAILER=resend
EMAIL_PRIMARY_PROVIDER=primary
EMAIL_FALLBACK_PROVIDER=fallback
EMAIL_FROM=noreply@cresdynamics.local
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=
RESEND_FROM_EMAIL_FINANCE=
RESEND_REPLY_TO_FINANCE=
RESEND_FROM_EMAIL_SALES=
RESEND_REPLY_TO_SALES=
RESEND_FROM_EMAIL_DIRECTOR=
RESEND_REPLY_TO_DIRECTOR=

# Admin Inbox AI (IMAP — Private Email / similar)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_ENCRYPTION=ssl

# Groq (AI drafts) — GROQ_MODEL must be a model id, not an API key
GROQ_API_KEY=
GROQ_API_KEY_SECONDARY=
GROQ_API_KEY_TERTIARY=
GROQ_MODEL=llama-3.1-8b-instant

QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
